if(NOT DEFINED SOURCE OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "SOURCE and OUTPUT are required")
endif()
file(READ "${SOURCE}" source)
string(FIND "${source}" "#version" version)
if(version LESS 0)
    message(FATAL_ERROR "Missing shader version: ${SOURCE}")
endif()
string(SUBSTRING "${source}" ${version} -1 source)
string(HEX "${source}" bytes)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
get_filename_component(name "${SOURCE}" NAME_WE)
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
# ncnn's failure diagnostics may print the source as a C string, even with an explicit source length.
file(WRITE "${OUTPUT}" "static const char ${name}_comp_data[] = {${bytes}0x00};\n")
