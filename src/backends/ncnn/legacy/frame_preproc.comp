// RGB8 bytes (packed into uint words, any row stride) -> normalized planar float, zero padded.
#version 450

#if NCNN_fp16_storage
#extension GL_EXT_shader_16bit_storage: require
#endif
#if NCNN_fp16_arithmetic
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require
#endif

layout (binding = 0) readonly buffer source_blob { uint source_data[]; };
layout (binding = 1) writeonly buffer top_blob { sfp top_blob_data[]; };

layout (push_constant) uniform parameter
{
    int sourceWidth;
    int sourceHeight;
    int strideBytes;
    int w;
    int h;
    int cstep;
} p;

void main()
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    int gz = int(gl_GlobalInvocationID.z);

    if (gx >= p.w || gy >= p.h || gz >= 3)
        return;

    float v = 0.f;
    if (gx < p.sourceWidth && gy < p.sourceHeight)
    {
        int byteIndex = gy * p.strideBytes + gx * 3 + gz;
        uint word = source_data[byteIndex >> 2];
        v = float((word >> uint((byteIndex & 3) * 8)) & 0xffu) * (1.f / 255.f);
    }

    buffer_st1(top_blob_data, gz * p.cstep + gy * p.w + gx, afp(v));
}
