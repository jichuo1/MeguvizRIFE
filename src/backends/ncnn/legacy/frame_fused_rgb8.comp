// Fused low-resolution flow/mask upscale, full-resolution warp/blend and RGB8 packing.
// Same RIFE weights and flow scale; avoids all full-resolution flow/warp/blend intermediates.
#version 450
#if NCNN_fp16_storage
#extension GL_EXT_shader_16bit_storage: require
#endif
#if NCNN_fp16_arithmetic
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require
#define afpvec3 f16vec3
#else
#define afpvec3 vec3
#endif
#if NCNN_fp16_storage
#define sfpvec3 f16vec3
#else
#define sfpvec3 vec3
#endif
layout(binding=0) readonly buffer flow_blob { sfp flow_data[]; };
layout(binding=1) writeonly buffer target_blob { uint target_data[]; };
layout(binding=2) buffer flag_blob { uint flag_data[]; };
layout(binding=3) readonly buffer left_blob { uint left_data[]; };
layout(binding=4) readonly buffer right_blob { uint right_data[]; };
layout(binding=5) readonly buffer mask_blob { sfp mask_data[]; };
layout(push_constant) uniform parameter {
    int width; int height; int words; int w; int inputCstep; int protectDetails;
    int h; int flowW; int flowH; int flowCstep; int flowPack; int scale; int rightStride;
    // guard: per-pixel motion-confidence fallback and unreliable-pixel counting (flag_data[1]).
    float timestep; int guard;
    // Frame-wide brightness change (right vs left channel means): offset model and gain model.
    float offsetR; float offsetG; float offsetB; float gainR; float gainG; float gainB;
} p;
vec3 leftPixel(int x,int y) {
    if(x>=p.width || y>=p.height) return vec3(0.f);
    vec3 result;
    for(int c=0;c<3;c++) {
        int byteIndex=y*p.inputCstep+x*3+c;
        uint word=left_data[byteIndex>>2];
        float value=float((word>>uint((byteIndex&3)*8))&0xffu)*(1.f/255.f);
        result[c]=float(sfp(afp(value)));
    }
    return result;
}
vec3 rightPixel(int x,int y) {
    if(x>=p.width || y>=p.height) return vec3(0.f);
    vec3 result;
    for(int c=0;c<3;c++) {
        int byteIndex=y*p.rightStride+x*3+c;
        uint word=right_data[byteIndex>>2];
        float value=float((word>>uint((byteIndex&3)*8))&0xffu)*(1.f/255.f);
        result[c]=float(sfp(afp(value)));
    }
    return result;
}

// Only stationary neutral ink on a stationary high-contrast patch is eligible. Checking RGB
// and the whole neighbourhood avoids locking moving text or a changing subtitle to the screen.
bool stationaryInk(int x, int y, vec3 a)
{
    if (x < 2 || y < 2 || x >= p.width - 2 || y >= p.height - 2) return false;
    float lo = min(a.r, min(a.g, a.b));
    float hi = max(a.r, max(a.g, a.b));
    if (hi - lo > 12.f / 255.f || (hi > 32.f / 255.f && lo < 192.f / 255.f)) return false;
    if (any(greaterThan(abs(a - rightPixel(x, y)), vec3(2.f / 255.f)))) return false;
    float low = a.g, high = a.g;
    for (int dy = -2; dy <= 2; dy += 2)
        for (int dx = -2; dx <= 2; dx += 2)
        {
            vec3 l = leftPixel(x + dx, y + dy);
            vec3 r = rightPixel(x + dx, y + dy);
            if (any(greaterThan(abs(l - r), vec3(3.f / 255.f)))) return false;
            low = min(low, l.g);
            high = max(high, l.g);
        }
    return high - low >= 64.f / 255.f;
}


afpvec4 flowPixel(int x, int y) {
    int i=y*p.flowW+x;
    if (p.flowPack==4) return afpvec4(buffer_ld1(flow_data,i*4), buffer_ld1(flow_data,i*4+1),
                                    buffer_ld1(flow_data,i*4+2), buffer_ld1(flow_data,i*4+3));
    return afpvec4(buffer_ld1(flow_data,i), buffer_ld1(flow_data,p.flowCstep+i),
                   buffer_ld1(flow_data,2*p.flowCstep+i), buffer_ld1(flow_data,3*p.flowCstep+i));
}
afpvec3 warpPixel(int x,int y,afpvec2 flow,bool right) {
    // Positions in fp32: fp16 spacing is 2 px above 2048, which snapped 4K samples to even pixels.
    vec2 samplexy=vec2(x,y)+vec2(flow);
    ivec2 a=ivec2(floor(samplexy));
    ivec2 b=clamp(a+1,ivec2(0),ivec2(p.w-1,p.h-1));
    a=clamp(a,ivec2(0),ivec2(p.w-1,p.h-1));
    afpvec2 f=afpvec2(samplexy-vec2(a));
    afpvec3 v0=afpvec3(right?rightPixel(a.x,a.y):leftPixel(a.x,a.y));
    afpvec3 v1=afpvec3(right?rightPixel(b.x,a.y):leftPixel(b.x,a.y));
    afpvec3 v2=afpvec3(right?rightPixel(a.x,b.y):leftPixel(a.x,b.y));
    afpvec3 v3=afpvec3(right?rightPixel(b.x,b.y):leftPixel(b.x,b.y));
    afpvec3 v4=v0*(afp(1.f)-f.x)+v1*f.x;
    afpvec3 v5=v2*(afp(1.f)-f.x)+v3*f.x;
    return v4*(afp(1.f)-f.y)+v5*f.y;
}
float pixelError=0.f;
float flowSpread=0.f;
const float GUARD_LOW=0.30f, GUARD_HIGH=0.55f, GUARD_COUNT=0.25f;
const int GUARD_TILES_X=16, GUARD_TILES_Y=9;
vec3 mergedPixel(int x,int y) {
    // ncnn Interp, align_corner=false, with replicated border.
    vec2 g=(vec2(x,y)+0.5f)/float(p.scale)-0.5f;
    ivec2 a=ivec2(floor(g)); afpvec2 f=afpvec2(g-vec2(a));
    bvec2 under=lessThan(a,ivec2(0)), over=greaterThan(a,ivec2(p.flowW-2,p.flowH-2));
    a=clamp(a,ivec2(0),ivec2(p.flowW-2,p.flowH-2));
    f=mix(f,afpvec2(0.f),under); f=mix(f,afpvec2(1.f),over);
    afpvec4 f00=flowPixel(a.x,a.y), f10=flowPixel(a.x+1,a.y), f01=flowPixel(a.x,a.y+1), f11=flowPixel(a.x+1,a.y+1);
    afpvec4 q0=f00*(afp(1.f)-f.x)+f10*f.x;
    afpvec4 q1=f01*(afp(1.f)-f.x)+f11*f.x;
    // Flow coherence: spread of the four neighbouring low-resolution vectors, in full-resolution pixels.
    vec4 fm=(vec4(f00)+vec4(f10)+vec4(f01)+vec4(f11))*0.25f;
    vec4 fs=max(max(abs(vec4(f00)-fm),abs(vec4(f10)-fm)),max(abs(vec4(f01)-fm),abs(vec4(f11)-fm)));
    flowSpread=max(max(fs.x,fs.y),max(fs.z,fs.w))*float(p.scale);
    afpvec4 flow=afpvec4(sfpvec4(q0*(afp(1.f)-f.y)+q1*f.y))*afp(p.scale);
    flow=afpvec4(sfpvec4(flow));
    int i=a.y*p.flowW+a.x;
    afp m0=buffer_ld1(mask_data,i)*(afp(1.f)-f.x)+buffer_ld1(mask_data,i+1)*f.x;
    afp m1=buffer_ld1(mask_data,i+p.flowW)*(afp(1.f)-f.x)+buffer_ld1(mask_data,i+p.flowW+1)*f.x;
    afp mask=afp(sfp(m0*(afp(1.f)-f.y)+m1*f.y));
    if (any(isnan(vec4(flow)))||any(isinf(vec4(flow)))||isnan(float(mask))||isinf(float(mask)))
        return vec3(uintBitsToFloat(0x7fc00000u));
    afp inv=afp(sfp(afp(1.f)-mask));
    afpvec3 l=afpvec3(sfpvec3(warpPixel(x,y,flow.xy,false)));
    afpvec3 r=afpvec3(sfpvec3(warpPixel(x,y,flow.zw,true)));
    afpvec3 aa=afpvec3(sfpvec3(l*mask));
    afpvec3 bb=afpvec3(sfpvec3(r*inv));
    vec3 merged=vec3(sfpvec3(aa+bb));
    if (p.guard != 0) {
        // Motion confidence: where both warps land on clearly different colours the flow has failed
        // (scene cut, flash, motion beyond the flow range). Fade towards the unwarped time-weighted
        // blend, which ghosts instead of tearing. Occlusions disagree too but are narrow; the ramp
        // starts high so that the mask still decides there.
        // Flashes and fades change every pixel by a frame-wide offset or gain while the flow stays
        // valid; compare under whichever model explains the pair better.
        vec3 lv=vec3(l), rv=vec3(r);
        vec3 d=min(abs(lv+vec3(p.offsetR,p.offsetG,p.offsetB)-rv), abs(lv*vec3(p.gainR,p.gainG,p.gainB)-rv));
        // A decisive mask over a smooth flow field means the network chose one side on purpose
        // (occlusion, large but coherent motion). Treat a contradiction as a failure only where the mask
        // is undecided or the flow field itself is chaotic, as it is across a cut.
        float undecided=1.f-smoothstep(0.2f,0.4f,abs(float(mask)-0.5f));
        float chaotic=smoothstep(4.f,12.f,flowSpread);
        float suspect=max(undecided,chaotic);
        pixelError=max(d.r,max(d.g,d.b))*step(0.5f,suspect);
        float w=smoothstep(GUARD_LOW,GUARD_HIGH,max(d.r,max(d.g,d.b)))*suspect;
        if (w>0.f) merged=mix(merged,mix(leftPixel(x,y),rightPixel(x,y),p.timestep),w);
    }
    return merged;
}
void main() {
    int group=int(gl_GlobalInvocationID.x);
    if (group*4>=p.width*p.height) return;
    uvec3 packed=uvec3(0u); bool bad=false; uint unreliable=0u;
    for(int j=0;j<4;j++) {
        int pixel=group*4+j; if(pixel>=p.width*p.height) break;
        int y=pixel/p.width, x=pixel-y*p.width;
        vec3 value=mergedPixel(x,y);
        bad=bad||any(isnan(value))||any(isinf(value));
        if(pixelError>GUARD_COUNT) unreliable++;
        if(p.protectDetails!=0) {
            vec3 original=leftPixel(x,y);
            if(any(greaterThanEqual(abs(value-original),vec3(0.5f/255.f))) && stationaryInk(x,y,original)) value=original;
        }
        uvec3 rgb=uvec3(clamp(value*255.f+0.5f,0.f,255.f));
        for(int c=0;c<3;c++) { int k=j*3+c; packed[k/4]|=rgb[c]<<uint((k%4)*8); }
    }
    for(int i=0;i<3;i++) if(group*3+i<p.words) target_data[group*3+i]=packed[i];
    if(bad) atomicOr(flag_data[0],1u);
    // Sampled count (every 8th group) keeps atomics cheap; the engine scales it by the sampled pixels.
    // flag_data[2..] holds the same count per tile of a 16x9 grid (tile of the group's first pixel).
    if(p.guard!=0 && unreliable>0u && group%8==0) {
        atomicAdd(flag_data[1],unreliable);
        int first=group*4, ty=first/p.width, tx=first-ty*p.width;
        atomicAdd(flag_data[2+(ty*GUARD_TILES_Y/p.height)*GUARD_TILES_X+tx*GUARD_TILES_X/p.width],unreliable);
    }
}
