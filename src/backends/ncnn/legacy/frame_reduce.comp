// RGB8 -> low-resolution input, preserving normalized FP16 source rounding and zero padding.
// For integer scales 2/4/8, align_corner=false samples the four central neighbours (as ncnn Interp does).
#version 450
#if NCNN_fp16_storage
#extension GL_EXT_shader_16bit_storage: require
#endif
#if NCNN_fp16_arithmetic
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require
#endif
layout(binding=0) readonly buffer source_blob { uint source_data[]; };
layout(binding=1) writeonly buffer target_blob { sfp target_data[]; };
layout(push_constant) uniform parameter {
    int width; int height; int stride; int w; int h; int cstep; int scale;
} p;
afp sourcePixel(int x,int y,int c) {
    if(x>=p.width || y>=p.height) return afp(0.f);
    int i=y*p.stride+x*3+c;
    float value=float((source_data[i>>2]>>uint((i&3)*8))&255u)*(1.f/255.f);
    return afp(sfp(afp(value)));
}
void main() {
    int x=int(gl_GlobalInvocationID.x),y=int(gl_GlobalInvocationID.y),c=int(gl_GlobalInvocationID.z);
    if(x>=p.w || y>=p.h || c>=3) return;
    // Coordinates in fp32 (fp16 spacing is 2 px above 2048); matches the downscale net, which runs
    // without fp16 arithmetic for the same reason.
    vec2 g=(vec2(x,y)+.5f)*float(p.scale)-.5f;
    ivec2 s=ivec2(floor(g)); afpvec2 f=afpvec2(g-vec2(s));
    ivec2 limit=ivec2(p.w*p.scale-2,p.h*p.scale-2);
    bvec2 under=lessThan(s,ivec2(0)),over=greaterThan(s,limit);
    s=clamp(s,ivec2(0),limit);
    f=mix(f,afpvec2(0.f),under); f=mix(f,afpvec2(1.f),over);
    afp a=sourcePixel(s.x,s.y,c)*(afp(1.f)-f.x)+sourcePixel(s.x+1,s.y,c)*f.x;
    afp b=sourcePixel(s.x,s.y+1,c)*(afp(1.f)-f.x)+sourcePixel(s.x+1,s.y+1,c)*f.x;
    buffer_st1(target_data,c*p.cstep+y*p.w+x,a*(afp(1.f)-f.y)+b*f.y);
}
