// Planar float (padded) -> tight RGB8 bytes packed into uint words; flags any non-finite value.
#version 450

#if NCNN_fp16_storage
#extension GL_EXT_shader_16bit_storage: require
#endif
#if NCNN_fp16_arithmetic
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require
#endif

layout (binding = 0) readonly buffer bottom_blob { sfp bottom_blob_data[]; };
layout (binding = 1) writeonly buffer target_blob { uint target_data[]; };
layout (binding = 2) buffer flag_blob { uint flag_data[]; };
layout (binding = 3) readonly buffer left_blob { sfp left_data[]; };
layout (binding = 4) readonly buffer right_blob { sfp right_data[]; };

layout (push_constant) uniform parameter
{
    int width;
    int height;
    int words;
    int w;
    int cstep;
    int inputCstep;
    int protectDetails;
} p;

vec3 leftPixel(int x, int y)
{
    int i = y * p.w + x;
    return vec3(float(buffer_ld1(left_data, i)), float(buffer_ld1(left_data, p.inputCstep + i)),
                float(buffer_ld1(left_data, 2 * p.inputCstep + i)));
}

vec3 rightPixel(int x, int y)
{
    int i = y * p.w + x;
    return vec3(float(buffer_ld1(right_data, i)), float(buffer_ld1(right_data, p.inputCstep + i)),
                float(buffer_ld1(right_data, 2 * p.inputCstep + i)));
}

// Only stationary neutral ink on a stationary high-contrast patch is eligible. Checking RGB
// and the whole neighbourhood avoids locking moving text or a changing subtitle to the screen.
bool stationaryInk(int x, int y, vec3 a)
{
    if (x < 2 || y < 2 || x >= p.width - 2 || y >= p.height - 2) return false;
    float lo = min(a.r, min(a.g, a.b));
    float hi = max(a.r, max(a.g, a.b));
    if (hi - lo > 12.f / 255.f || (hi > 32.f / 255.f && lo < 192.f / 255.f)) return false;
    if (any(greaterThan(abs(a - rightPixel(x, y)), vec3(2.f / 255.f)))) return false;
    float low = a.g, high = a.g;
    for (int dy = -2; dy <= 2; dy += 2)
        for (int dx = -2; dx <= 2; dx += 2)
        {
            vec3 l = leftPixel(x + dx, y + dy);
            vec3 r = rightPixel(x + dx, y + dy);
            if (any(greaterThan(abs(l - r), vec3(3.f / 255.f)))) return false;
            low = min(low, l.g);
            high = max(high, l.g);
        }
    return high - low >= 64.f / 255.f;
}

void main()
{
    int gx = int(gl_GlobalInvocationID.x);
    if (gx >= p.words)
        return;

    int total = p.width * p.height * 3;
    uint packed = 0u;
    bool bad = false;
    int previousPixel = -1;
    vec3 original = vec3(0.f);
    bool preserve = false;
    bool assessed = false;
    for (int k = 0; k < 4; k++)
    {
        int byteIndex = gx * 4 + k;
        if (byteIndex >= total)
            break;
        int pixel = byteIndex / 3;
        int channel = byteIndex - pixel * 3;
        int y = pixel / p.width;
        int x = pixel - y * p.width;
        float v = float(buffer_ld1(bottom_blob_data, channel * p.cstep + y * p.w + x));
        bad = bad || isnan(v) || isinf(v);
        if (p.protectDetails != 0)
        {
            // 一个 word 的相邻通道共享判断，避免为同一 RGB 像素反复读取 3×3 邻域。
            if (pixel != previousPixel)
            {
                original = leftPixel(x, y);
                assessed = false;
                preserve = false;
                previousPixel = pixel;
            }
            // 相同的量化结果无需修复；大片静止黑底/白底不应为每个通道读取完整邻域。
            if (!assessed && abs(v - original[channel]) >= 0.5f / 255.f)
            {
                preserve = stationaryInk(x, y, original);
                assessed = true;
            }
            if (preserve) v = original[channel];
        }
        uint byteValue = uint(clamp(v * 255.f + 0.5f, 0.f, 255.f));
        packed |= byteValue << uint(k * 8);
    }
    target_data[gx] = packed;
    if (bad)
        atomicOr(flag_data[0], 1u);
}
